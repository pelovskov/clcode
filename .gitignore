# Macens skjulte systemfiler
.DS_Store

# Søgeindeks · Online (sbtv): adgangskoder og driftsdata hører til på serveren, ikke i repoet.
# Repoet er offentligt. Brug sbtv/config-eksempel.php som skabelon til config.php.
sbtv/config.php
sbtv/data/*
!sbtv/data/.htaccess
!sbtv/data/foreninger.json
sbtv/filer/*
!sbtv/filer/.htaccess

# Historiehylden: zip-filerne ligger kun på webhotellet
afspiller/hylde/*.zip

# SFB-afspillerens adminside: adgangskoder og driftsdata hører til på webhotellet.
# Brug afspiller/admin/config-eksempel.php som skabelon til config.php.
afspiller/admin/config.php
afspiller/admin/data/*
!afspiller/admin/data/.htaccess
afspiller/venter/*.zip
